---
import Base from '../../../layouts/Base.astro';
import Game from '../../../components/Game.astro';
import SeoBlock from '../../../components/SeoBlock.astro';
import { LANGS, MODE_SLUG, REGIONS, COUNTRIES, SITE, regionOf } from '../../../lib/site.js';
import { landing, MODE_NAME, REGION_NAME } from '../../../lib/copy.js';

export const getStaticPaths = () =>
  LANGS.flatMap((lang) =>
    Object.entries(MODE_SLUG).flatMap(([mode, mslug]) =>
      Object.keys(REGIONS).map((region) => ({ params: { lang, mode: mslug, region }, props: { qmode: mode } })),
    ),
  );
const { lang, mode, region } = Astro.params;
const { qmode } = Astro.props;
const n = COUNTRIES.filter((c) => region === 'world' || regionOf(c.cont) === region).length;
const c = landing(lang, qmode, region, n);
const path = `${mode}/${region}/`;
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'zh' ? '首页' : 'Home', item: `${SITE}/${lang}/` },
    { '@type': 'ListItem', position: 2, name: MODE_NAME[lang][qmode], item: `${SITE}/${lang}/${mode}/world/` },
    { '@type': 'ListItem', position: 3, name: REGION_NAME[lang][region], item: `${SITE}/${lang}/${path}` },
  ],
}];
---
<Base lang={lang} path={path} title={c.title} description={c.description} jsonld={jsonld}>
  <Game lang={lang} path={path} qmode={qmode} cont={REGIONS[region]}>
    <SeoBlock lang={lang} h1={c.h1} intro={c.intro} region={region} mode={qmode} />
  </Game>
</Base>
