---
import Base from '../../layouts/Base.astro';
import Game from '../../components/Game.astro';
import SeoBlock from '../../components/SeoBlock.astro';
import { LANGS, SITE } from '../../lib/site.js';
import { HOME } from '../../lib/copy.js';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const c = HOME[lang];
const jsonld = [{
  '@context': 'https://schema.org', '@type': 'WebApplication', name: c.h1, url: `${SITE}/${lang}/`,
  applicationCategory: 'EducationalApplication', operatingSystem: 'Any', inLanguage: lang,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
}];
---
<Base lang={lang} title={c.title} description={c.description} jsonld={jsonld}>
  <Game lang={lang}><SeoBlock lang={lang} h1={c.h1} intro={c.intro} /></Game>
</Base>
